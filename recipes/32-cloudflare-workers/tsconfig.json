{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "test/e2e"
  ]
}
