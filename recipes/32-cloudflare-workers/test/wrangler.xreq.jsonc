// Cross-request experiment: npx wrangler dev -c test/wrangler.xreq.jsonc --port 8799
// then fire concurrent curls (see the header of xreq.worker.ts).
{
  "name": "xreq",
  "main": "xreq.worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@dnsid-ai/transport": "../src/shims/transport.ts" },
  "durable_objects": { "bindings": [{ "name": "NONCES", "class_name": "NonceStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NonceStore"] }]
}
