# Copy to .env.local (gitignored) and fill in values.

# GitHub App credentials
# App ID is not sensitive, but it is specific to your app.
GITHUB_APP_ID=<GITHUB_APP_ID>
# Path to the downloaded private key .pem file (local dev only)
# Download from: github.com/settings/apps/<your-app-slug> -> Private keys
GITHUB_APP_KEY_PATH=/path/to/github-app.private-key.pem
# Secrets Manager name used by deployed CDK.
GITHUB_APP_KEY_SECRET_NAME=github-review-bot/private-key

# AWS credentials — used for Bedrock model invocations.
# If already set in your environment (AWS_ACCESS_KEY_ID etc.) leave blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# DNSid identity for the bot (outbound auth)
BOT_DOMAIN=<your-bot-domain>.dev.dnsid.ai
# Unique audience for this gateway deployment; use its MCP URL if already deployed.
# Required at CDK deploy time and injected into the runtime for token minting.
REVIEW_GATEWAY_AUDIENCE=https://review-gateway.example.com/mcp
# Directory containing the server-side config.json and private.jwk.
DNSID_CONFIG_DIR=/path/to/dnsid/identity
DNSID_SERVER=https://api.dnsid.ai

# Audit endpoint — URL of the service the bot calls after each review
# Use http://localhost:9090 when running scripts/audit_server.py locally
AUDIT_ENDPOINT=http://localhost:9090
